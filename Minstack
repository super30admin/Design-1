class MinStack:
    def __init__(self):
        self.st = []            # single stack
        self.min = float('inf') # current minimum

    def push(self, val):
        if val <= self.min:
            self.st.append(self.min)  # save old min
            self.min = val
        self.st.append(val)

    def pop(self):
        x = self.st.pop()
        if x == self.min:            # popped current min -> restore previous
            self.min = self.st.pop()

    def top(self):
        return self.st[-1]

    def getMin(self):
        return self.min
